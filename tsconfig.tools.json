{
  // Build scripts and end-to-end tests: Node code that also sends functions to run in a browser (page.evaluate).
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tools.tsbuildinfo",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node"]
  },
  "include": ["scripts", "e2e", "playwright.config.ts"]
}
