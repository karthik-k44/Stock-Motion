{
  "name": "stockmotion",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --tsconfig tsconfig.node.json --clear-screen=false --exclude \"src/frontend/**\" src/backend/server.ts",
    "build": "tsc -b && vite build",
    "build:server": "tsx scripts/build-server.ts",
    "start": "cross-env NODE_ENV=production node --enable-source-maps build/server/server.mjs",
    "db:migrate": "tsx --tsconfig tsconfig.node.json src/backend/db/cli/migrate.ts",
    "db:seed": "tsx --tsconfig tsconfig.node.json src/backend/db/cli/seed.ts",
    "db:migration:create": "tsx scripts/new-migration.ts",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "npm run build && npm run build:server && playwright test",
    "typecheck": "tsc -b --noEmit",
    "illustrations": "tsx scripts/illustrations/build.ts",
    "vercel-build": "tsx scripts/vercel-build.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@fontsource-variable/caveat": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@tanstack/react-query": "^5.104.2",
    "axios": "^1.20.0",
    "bcryptjs": "3.0.3",
    "class-variance-authority": "^0.7.1",
    "compression": "^1.8.2",
    "cookie-parser": "1.4.7",
    "cross-env": "^10.1.0",
    "express": "^5.3.0",
    "gsap": "^3.15.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "9.0.3",
    "lucide-react": "^1.60.0",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.18.4",
    "roughjs": "^4.6.6",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "tailwind-merge": "^3.7.0",
    "typeorm": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9",
    "typescript-eslint": "^8.71.2",
    "vite": "^6.4.4",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.11.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js}": "node ./node_modules/eslint/bin/eslint.js --fix --max-warnings=0"
  }
}
