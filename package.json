{
  "name": "stockmotion",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --tsconfig tsconfig.node.json --clear-screen=false --exclude \"src/frontend/**\" src/backend/server.ts",
    "build": "tsc -b && vite build",
    "start": "cross-env NODE_ENV=production tsx --tsconfig tsconfig.node.json src/backend/server.ts",
    "db:migrate": "tsx --tsconfig tsconfig.node.json src/backend/db/migrate.ts",
    "db:seed": "tsx --tsconfig tsconfig.node.json src/backend/db/seed.ts",
    "lint": "eslint src",
    "test": "vitest run",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.1",
    "@tanstack/react-query": "^5.104.2",
    "axios": "^1.20.0",
    "bcryptjs": "3.0.3",
    "cookie-parser": "1.4.7",
    "cross-env": "^10.1.0",
    "express": "^5.3.0",
    "jsonwebtoken": "9.0.3",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.18.4",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "three": "0.186.1",
    "tsx": "^4.23.15",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "supertest": "^7.3.1",
    "typescript": "5.9",
    "typescript-eslint": "^8.71.2",
    "vite": "^6.4.4",
    "vitest": "^3.2.7"
  }
}
