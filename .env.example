# Copy to .env for local settings (git-ignored). On a host, set these as environment variables instead.

# development | production
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Postgres connection. Leave empty to use the embedded Postgres (PGlite) stored in PGLITE_DIR.
DATABASE_URL=
PGLITE_DIR=.data/pglite
# PostgreSQL connections per server instance. Keep it small (e.g. 3) on Vercel, where many instances run at once.
DB_POOL_SIZE=10

# 32+ random characters. Required in production (e.g. `openssl rand -hex 48`).
JWT_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30

# Proxies to trust for the client IP and HTTPS: "1" behind one load balancer (most hosts), "true", or a list.
TRUST_PROXY=loopback
# Grace period for open requests when the host stops the server.
SHUTDOWN_TIMEOUT_MS=10000

# Razorpay (Dashboard → Account & Settings → API Keys; rzp_test_… in test mode). Leave empty and billing runs in
# manual mode outside production: choosing a plan switches to it at once, with no payment.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# The secret you set on the Razorpay webhook (Dashboard → Settings → Webhooks) — deployed sites only.
RAZORPAY_WEBHOOK_SECRET=
# ORDERS (default): each month or year is paid for once. SUBSCRIPTIONS: Razorpay renews by itself (needs Subscriptions
# enabled on the Razorpay account).
RAZORPAY_BILLING_MODE=ORDERS

# Optional, for `npm test`: run the suite against a real PostgreSQL database instead of in-memory PGlite.
# Its name must contain "test" — every table in it is emptied.
# TEST_DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/stockmotion_test
